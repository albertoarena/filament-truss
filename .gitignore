# Dependencies
/vendor/
composer.lock
/node_modules/

# package-lock.json is deliberately NOT ignored, unlike composer.lock above. It
# locks test tooling only, nothing a consumer of this package ever installs, and
# committing it is what lets CI run `npm ci`: a resolved install rather than one
# that picks a fresh transitive tree on every run.

# Test / tooling caches
/.phpunit.cache/
.phpunit.result.cache
/build/
/coverage/

# Private/local docs (note: the tracked docs/ folder is NOT ignored).
# No trailing slash on purpose: a trailing slash matches directories only, so
# the entry would not cover a symlink of the same name, and git records a
# symlink as a file. Without the slash it covers both.
/.docs

# IDE files
/.idea/
/.vscode/
*.iml
*.swp
.DS_Store

# Local Claude files
CLAUDE.local.md
CLAUDE.*.local.md
