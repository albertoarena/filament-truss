# Keep the installed package to what an application runs. Everything below is
# for developing, testing, documenting or showing the package, and none of it
# needs to be in anybody's vendor directory.
#
# `resources/` and `routes/` are deliberately absent from this list: the views,
# the language files, the built stylesheet and the asset routes are what the
# page renders with.
/.github             export-ignore
/art                 export-ignore
/docs                export-ignore
/tests               export-ignore

/.gitattributes      export-ignore
/.gitignore          export-ignore
/CHANGELOG.md        export-ignore
/CLAUDE.md           export-ignore
/CONTRIBUTING.md     export-ignore
/package.json        export-ignore
/package-lock.json   export-ignore
/phpunit.xml         export-ignore
/pint.json           export-ignore
/vitest.config.js    export-ignore
