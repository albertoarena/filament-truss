{
    "name": "albertoarena/filament-truss",
    "description": "A live ER diagram (ERD) of your real database as a native page inside a Filament panel. Built on Laravel Truss. Structure only, never data.",
    "keywords": [
        "filament",
        "filamentphp",
        "filament-plugin",
        "laravel",
        "database",
        "schema",
        "er-diagram",
        "erd",
        "database-diagram",
        "truss"
    ],
    "homepage": "https://trussphp.com",
    "support": {
        "issues": "https://github.com/albertoarena/filament-truss/issues",
        "source": "https://github.com/albertoarena/filament-truss",
        "docs": "https://trussphp.com"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Alberto Arena",
            "email": "arena.alberto@gmail.com",
            "role": "Developer"
        }
    ],
    "funding": [
        {
            "type": "ko-fi",
            "url": "https://ko-fi.com/albertoarena"
        }
    ],
    "require": {
        "php": "^8.2",
        "albertoarena/laravel-truss": "^1.12",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "AlbertoArena\\FilamentTruss\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlbertoArena\\FilamentTruss\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage",
        "lint": "vendor/bin/pint --test",
        "lint:fix": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AlbertoArena\\FilamentTruss\\FilamentTrussServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
